# Copie este arquivo para .env e preencha.
# O .env está no .gitignore e NUNCA deve ser comitado.

# --- Servidor ---
PORTA=8080

# --- MySQL ---
# Formato DSN do go-sql-driver/mysql:
#   usuario:senha@tcp(host:porta)/banco?params
# parseTime=true faz o driver devolver DATE/TIMESTAMP como time.Time
MYSQL_DSN=jarvis:TROQUE_ESTA_SENHA@tcp(127.0.0.1:3306)/jarvis?parseTime=true&charset=utf8mb4&loc=Local

# --- GroqCloud: LLM do chat (Fase 4) ---
# Chave gratuita em https://console.groq.com/keys. Vazio = chat desligado.
# A chave NUNCA vai para o frontend. Todas as chamadas saem do backend Go.
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b

# --- Outro provedor de IA (opcional) ---
# Qualquer API compativel com a da OpenAI. Se LLM_CHAVE estiver preenchida, vale no lugar do Groq.
# Gemini: LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#         LLM_MODELO=gemini-2.5-flash
# LLM_URL=
# LLM_CHAVE=
# LLM_MODELO=

# --- Nuvem (ver docs/NUVEM.md) ---
# MIGRAR_NA_SUBIDA=1 aplica as migrations ao subir (precisa de usuario com permissao de DDL).
# MYSQL_CA: PEM da CA do banco, so para provedor que exige (DSN com tls=jarvis). TiDB usa tls=true.
# MIGRAR_NA_SUBIDA=
# MYSQL_CA=
# INTEGRACAO_FAMILIA=1

# --- Claude API (alternativa ao Groq) ---
# A chave NUNCA vai para o frontend. Todas as chamadas saem do backend Go.
ANTHROPIC_API_KEY=

# --- Pluggy / Open Finance (Fase 7) ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
